public class AcademicEvaluator {
    public static void main(String[] args) {
        // Hardcoded variables
        double gwa = 94.5;
        int lowestGrade = 88;

        // Outer IF-ELSE
        if (gwa >= 90.0) {
            // Inner nested IF-ELSE
            if (lowestGrade >= 85) {
                if (gwa >= 98.0) {
                    System.out.println("Academic Status: With Highest Honors");
                } else if (gwa >= 95.0) {
                    System.out.println("Academic Status: With High Honors");
                } else if (gwa >= 90.0) {
                    System.out.println("Academic Status: With Honors");
                }
            } else {
                System.out.println("Honors Disqualified due to grade below minimum requirement");
            }
        } else {
            System.out.println("Regular Passing Grade");
        }
    }
}


